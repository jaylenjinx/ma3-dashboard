<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MA3Dashboard.ViewModels"
             xmlns:v="using:MA3Dashboard.Views"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="MA3Dashboard.Views.ThemesView"
             x:DataType="vm:ThemesViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock Text="Color Themes" Classes="h1" />
                <TextBlock Text="{Binding Subtitle}" Classes="sub" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Library.Locations}" SelectedItem="{Binding Library.Selected}" MinWidth="170" />
                <Button Classes="tool" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open the colorthemes folder"><mi:MaterialIcon Kind="FolderOpen" /></Button>
                <Button Classes="accent tool" Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="FileImport" /><TextBlock Text="Import" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Selected}" Background="Transparent">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                    <!-- The card is the item, so mark the selected one with an amber edge instead of Fluent's fill behind it. -->
                    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border.card">
                        <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.card">
                        <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Width="210" Padding="12" ClipToBounds="True">
                            <StackPanel Spacing="8">
                                <!-- Mini preview: a sheet drawn in the theme's own colors, like the Mac app. -->
                                <Border Height="78" CornerRadius="6" Padding="6" ClipToBounds="True"
                                        Background="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=BackgroundDark}">
                                    <StackPanel Spacing="2">
                                        <Border CornerRadius="3" Padding="6,2" Background="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Header}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="Sequence" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Text}" />
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Selected}" />
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="2" Padding="6,1" Background="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=DefaultCellBackground}">
                                            <TextBlock Text="1  Cue 1" FontSize="9.5" Foreground="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Text}" />
                                        </Border>
                                        <Border CornerRadius="2" Padding="6,1" Background="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Selected}">
                                            <TextBlock Text="2  Cue 2" FontSize="9.5" Foreground="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=TextDark}" />
                                        </Border>
                                        <Border CornerRadius="2" Padding="6,1" Background="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=DefaultCellAltBackground}">
                                            <TextBlock Text="3  Cue 3" FontSize="9.5" Foreground="{Binding Converter={x:Static v:ThemeBrush.Instance}, ConverterParameter=Text}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Converter={x:Static v:ThemeSwatches.Instance}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="13" Height="10" CornerRadius="2" Background="{Binding}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="sub" Text="{Binding ColorCount, StringFormat='{}{0} colors'}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !Themes.Count}">
                <mi:MaterialIcon Kind="Palette" Width="40" Height="40" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="No color themes" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="Export a theme from onPC, or drop theme .xml files here." Classes="sub" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Detail -->
            <Border Grid.Column="1" Classes="card" Width="340" Margin="12,0,0,0" IsVisible="{Binding Selected, Converter={x:Static v:Conv.NotNull}}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.FileName}" Classes="sub" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Selected.DataVersion, StringFormat='Data version {0}'}" Classes="sub" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10">
                        <Button Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate"><mi:MaterialIcon Kind="ContentCopy" /></Button>
                        <Button Command="{Binding RevealCommand}" ToolTip.Tip="Show in folder"><mi:MaterialIcon Kind="FolderSearchOutline" /></Button>
                        <Button Command="{Binding TrashCommand}" ToolTip.Tip="Move to Recycle Bin"><mi:MaterialIcon Kind="TrashCanOutline" /></Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Selected.Groups}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,8">
                                        <TextBlock Text="{Binding Name}" Classes="section" />
                                        <ItemsControl ItemsSource="{Binding Colors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <Border Width="22" Height="16" CornerRadius="3" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                                Background="{Binding Rgba, Converter={x:Static v:RgbaBrush.Instance}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Rgba}" Classes="sub" FontFamily="Consolas,Menlo,monospace" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
