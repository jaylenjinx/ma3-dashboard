<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MA3Dashboard.ViewModels"
             xmlns:v="using:MA3Dashboard.Views"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="MA3Dashboard.Views.InstallView"
             x:DataType="vm:InstallViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock Text="Install Versions" Classes="h1" />
                <TextBlock Text="{Binding SearchText}" Classes="sub" ToolTip.Tip="{Binding SearchPaths}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="accent tool" Command="{Binding AddCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Copy installers into installation_packages so they show up here">
                <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Plus" /><TextBlock Text="Add Installer" /></StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="INSTALLERS" Classes="section" />
                    <Border Classes="card" IsVisible="{Binding IsEmpty}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="No installers found" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hint}" Classes="sub" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <mi:MaterialIcon Kind="PackageVariantClosed" Width="28" Height="28" Margin="0,0,14,0" Foreground="{DynamicResource AmberBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <Border CornerRadius="4" Padding="6,0" BorderThickness="1" BorderBrush="{Binding Status, Converter={x:Static v:Conv.StatusBrush}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding Status, Converter={x:Static v:Conv.StatusBrush}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Classes="sub" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsIdle}" VerticalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True" Width="60" MinWidth="60" />
                                                <TextBlock Text="{Binding Progress}" Classes="sub" />
                                            </StackPanel>
                                            <Button Command="{Binding $parent[UserControl].DataContext.RevealCommand}" CommandParameter="{Binding}" ToolTip.Tip="Show in folder">
                                                <mi:MaterialIcon Kind="FolderSearchOutline" /></Button>
                                            <Button Command="{Binding $parent[UserControl].DataContext.OpenInstallerCommand}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsIdle}" ToolTip.Tip="Open MA's installer to choose options yourself">Open Installer</Button>
                                            <!-- Amber only for versions not installed yet; reinstalling stays a plain button. -->
                                            <Button Classes.accent="{Binding !IsInstalled}" Command="{Binding $parent[UserControl].DataContext.InstallCommand}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsIdle}" Content="{Binding IsInstalled, Converter={x:Static v:Conv.InstallLabel}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="INSTALLED ON THIS COMPUTER" Classes="section" />
                    <ItemsControl ItemsSource="{Binding Installed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                    <mi:MaterialIcon Kind="CheckCircleOutline" Foreground="{DynamicResource RunningBrush}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Path}" Classes="sub" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.RevealBuildCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="Show in folder"><mi:MaterialIcon Kind="FolderSearchOutline" /></Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
