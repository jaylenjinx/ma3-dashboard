<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MA3Dashboard.ViewModels"
             xmlns:v="using:MA3Dashboard.Views"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="MA3Dashboard.Views.DatapoolsView"
             x:DataType="vm:DatapoolsViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock Text="Datapools" Classes="h1" />
                <TextBlock Text="Presets, plugins, macros and other objects exported to the library" Classes="sub" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Library.Locations}" SelectedItem="{Binding Library.Selected}" MinWidth="170" />
                <Button Classes="tool" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open this pool's folder"><mi:MaterialIcon Kind="FolderOpen" /></Button>
                <Button Classes="accent tool" Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="FileImport" /><TextBlock Text="Import" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="200,*,Auto" Margin="0,16,0,0">
            <ListBox Classes="nav" ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}" Background="Transparent"
                     AutomationProperties.Name="Pools">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding VisibleCount}" Classes="sub" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="12,0,0,0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsVisible="{Binding !!Items.Count}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="160" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="FolderOutline" IsVisible="{Binding IsFolder}" Foreground="{DynamicResource MutedBrush}" />
                                        <mi:MaterialIcon Kind="FileOutline" IsVisible="{Binding !IsFolder}" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Width="110" Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Detail" Width="*" Binding="{Binding Detail}" />
                        <DataGridTextColumn Header="Size" Width="90" Binding="{Binding SizeText}" SortMemberPath="Size" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !Items.Count}">
                    <mi:MaterialIcon Kind="DatabaseOutline" Width="40" Height="40" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Nothing in this pool" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Export objects from onPC, or drop files here." Classes="sub" HorizontalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Row="1" Margin="0,8,0,0" IsChecked="{Binding ShowBackups}" IsVisible="{Binding BackupCount, Converter={x:Static v:Conv.NotZero}}"
                          Content="{Binding BackupCount, StringFormat='Show {0} backup files (.bak)'}" />
            </Grid>

            <Border Grid.Column="2" Classes="card" Width="340" Margin="12,0,0,0" IsVisible="{Binding Selected, Converter={x:Static v:Conv.NotNull}}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Selected.Kind}" Classes="sub" />
                        <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.FileName}" Classes="sub" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10">
                        <Button Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate"><mi:MaterialIcon Kind="ContentCopy" /></Button>
                        <Button Command="{Binding RevealCommand}" ToolTip.Tip="Show in folder"><mi:MaterialIcon Kind="FolderSearchOutline" /></Button>
                        <Button Command="{Binding TrashCommand}" ToolTip.Tip="Move to Recycle Bin"><mi:MaterialIcon Kind="TrashCanOutline" /></Button>
                    </StackPanel>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Attributes}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="110,*" Margin="0,2">
                                    <TextBlock Text="{Binding Key}" Classes="sub" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="3" Background="{DynamicResource CodeBrush}" CornerRadius="6" Padding="10"
                            IsVisible="{Binding Preview, Converter={x:Static v:Conv.NotNull}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding Preview}" FontFamily="Consolas,Menlo,monospace" FontSize="11.5" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
