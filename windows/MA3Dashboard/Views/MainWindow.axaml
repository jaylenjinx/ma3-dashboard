<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MA3Dashboard.ViewModels"
        xmlns:v="using:MA3Dashboard.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="MA3Dashboard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MA3 Dashboard" Icon="avares://MA3Dashboard/Assets/icon-256.png"
        Width="1280" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource PaneBrush}"
        DragDrop.AllowDrop="True">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:VersionViewModel"><v:VersionView /></DataTemplate>
        <DataTemplate DataType="vm:ThemesViewModel"><v:ThemesView /></DataTemplate>
        <DataTemplate DataType="vm:FixturesViewModel"><v:FixturesView /></DataTemplate>
        <DataTemplate DataType="vm:DatapoolsViewModel"><v:DatapoolsView /></DataTemplate>
        <DataTemplate DataType="vm:InstallViewModel"><v:InstallView /></DataTemplate>
        <DataTemplate DataType="vm:SyncViewModel"><v:SyncView /></DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="250,*">
        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ListBox Classes="nav" ItemsSource="{Binding Sidebar}" SelectedItem="{Binding SelectedItem}" Background="Transparent" Padding="8,10"
                     AutomationProperties.Name="Sidebar">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SidebarItem">
                        <Panel>
                            <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeader}" Classes="section" Margin="0,10,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSelectable}">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource AmberBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Subtitle}" Classes="sub" FontSize="11.5"
                                               IsVisible="{Binding Subtitle, Converter={x:Static v:Conv.NotEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource RunningBrush}" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsRunning}">
                                        <TextBlock Text="Running" FontSize="10.5" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="{DynamicResource AmberBrush}" CornerRadius="8" Padding="7,1"
                                            IsVisible="{Binding Badge, Converter={x:Static v:Conv.NotNull}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="10.5" Foreground="Black" FontWeight="SemiBold" />
                                    </Border>
                                    <ProgressBar IsIndeterminate="True" Width="24" MinWidth="24" IsVisible="{Binding IsBusy}" />
                                    <mi:MaterialIcon Kind="AlertCircle" Foreground="Orange" IsVisible="{Binding HasWarning}" />
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Page -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" Margin="24,18,24,18" />
            <Border IsVisible="{Binding Message, Converter={x:Static v:Conv.NotNull}}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                    Padding="16,10" CornerRadius="8" MaxWidth="720"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    BoxShadow="0 4 18 0 #40000000">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <mi:MaterialIcon Kind="AlertCircle" Foreground="IndianRed" IsVisible="{Binding MessageIsError}" />
                    <mi:MaterialIcon Kind="CheckCircle" Foreground="{DynamicResource RunningBrush}" IsVisible="{Binding !MessageIsError}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
